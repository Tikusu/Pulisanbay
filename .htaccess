RewriteEngine On

# Menghapus tulisan "index.php" dari URL jika ada yang mengetiknya
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)/?index\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Menghapus akhiran ".php" dari URL jika ada yang mengetiknya
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php [NC]
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /%1 [R=301,L]

# Custom URL untuk kamar (diletakkan sebelum rule forwarding public)
RewriteRule ^the-pulisan/club-room/?$ public/club-room.php [L]
RewriteRule ^the-pulisan/lower-bungalow/?$ public/lower-bungalow.php [L]
RewriteRule ^the-pulisan/upper-bungalow/?$ public/upper-bungalow.php [L]
RewriteRule ^the-pulisan/minahasa-suite/?$ public/minahasa-suite.php [L]

# Mengarahkan seluruh traffic ke dalam folder public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# Pasangkan ekstensi .php secara internal di dalam folder public/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]